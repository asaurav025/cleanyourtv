<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The ESPHome boards on the home network, and Yahoo's delayed quotes for the market strip. Nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keeps the note page answering: Android freezes a cached app (NoteService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".LightsActivity"
            android:exported="true"
            android:launchMode="singleTask" />

        <!-- Home's events in, the market line out. HomeProvider itself lets only the launcher and the ADB shell in. -->
        <provider
            android:name=".HomeProvider"
            android:authorities="${applicationId}.home"
            android:exported="true" />

        <receiver android:name=".Bell" android:exported="false" />

        <service
            android:name=".NoteService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Serves the home-network page that sends a note to the TV" />
        </service>
    </application>
</manifest>
