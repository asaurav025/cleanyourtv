<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The ESPHome boards on the home network, and Yahoo's delayed quotes for the market strip. Nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".LightsActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>

        <!-- Home's events in, the market line out. HomeProvider itself lets only the launcher and the ADB shell in. -->
        <provider
            android:name=".HomeProvider"
            android:authorities="${applicationId}.home"
            android:exported="true" />

        <receiver android:name=".Bell" android:exported="false" />
    </application>
</manifest>
